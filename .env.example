# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# Secret key for signing every session token. Generate your own — the server
# refuses to start on the old placeholder, because a key that ships in the
# repository lets anyone mint a token for any account here:
#
#   openssl rand -base64 48
#
# Left unset, the server generates one per boot and says so; that works, but
# everyone is signed out on every restart.
JWT_SECRET=

# Web Push. Both are optional: on first boot the server generates a VAPID
# keypair and stores it, which is enough for push to work.
#
# Set VAPID_PRIVATE_KEY only to hold the key outside the database — it is the
# base64url raw P-256 scalar, and changing it invalidates every device already
# enrolled. VAPID_SUBJECT is how a push service contacts this server's
# operator; it defaults to SERVER_URL when that is https, and must be a
# mailto: or https: URL.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
